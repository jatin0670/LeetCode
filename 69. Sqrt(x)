SOLUTION 1 :
TC : O(n)
SC : O(1)

class Solution {
    public int mySqrt(int x) {
        int ans = 0;

        for (int i = 1; i <= x; i++) {
            long val = (long) i * i;

            if (val > x) {
                break;
            }

            ans = i;
        }

        return ans;
    }
}

SOLUTION 2: binary 1
TC : O(log n)
SC : O(1)

class Solution {
    public int mySqrt(int x) {
        int low = 1;
        int high = x;
        int ans = 0;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            long val = (long) mid * mid;

            if (val > x) {
                high = mid - 1;
            } else {
                ans = mid;
                low = mid + 1;
            }
        }

        return ans;
    }
}


SOLUTION 2: binary 2 
TC : O(log n)
SC : O(1)

class Solution {
    public int mySqrt(int x) {
        int ans = 0;
        int low = 1,
                high = x;

        if (x == 0) {
            return 0;
        }

        if (x == 1) {
            return 1;
        }

        while (low < high) {
            int mid = low + (high - low) / 2;

            long val = (long) mid * mid;

            if (val > x) {
                high = mid;
            } else {
                low = mid + 1;
            }
        }

        return low - 1;
    }
}
