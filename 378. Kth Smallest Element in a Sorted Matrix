SOLUTION 1:
TC : O(min(N, k) + k.log(min(N, k)))
SC : O(min(N, k)

class Solution {
    public int kthSmallest(int[][] matrix, int k) {
        int N = matrix.length;
        PriorityQueue<int[]> minHeap = new PriorityQueue<>((a, b) -> a[0] - b[0]);

        for (int i = 0; i < Math.min(N, k); i++) {
            minHeap.add(new int[] {
                    matrix[i][0],
                    i,
                    0
            });

        }

        int counter = 1;

        while (!minHeap.isEmpty()) {
            int[] ele = minHeap.poll();

            int val = ele[0];
            int listId = ele[1];
            int eleId = ele[2];

            if (counter == k) {
                return val;
            }

            counter++;

            int nextEleId = eleId + 1;

            if (nextEleId < N) {
                minHeap.add(new int[] {
                        matrix[listId][nextEleId],
                        listId,
                        nextEleId
                });
            }
        }

        return -1;

    }
}
