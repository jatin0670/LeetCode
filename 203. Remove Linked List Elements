SOLUTION 1:
TC : O(n)
SC : O(1)

class Solution {
    public ListNode removeElements(ListNode head, int val) {
        ListNode dummy = new ListNode(0);
        dummy.next = head;

        ListNode prev = dummy;
        ListNode curr = head;

        while (curr != null) {
            ListNode next = curr.next;
            if (curr.val == val) {
                prev.next = curr.next;
                curr = next;
            } else {
                prev = curr;
                curr = next;
            }

        }

        return dummy.next;
    }
}
