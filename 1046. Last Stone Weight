SOLUITON 1:
TC : O(n2*longn)
SC : O(n) 

class Solution {
    public int lastStoneWeight(int[] stones) {
        List<Integer> list = new ArrayList<>();

        for(int stone : stones){
            list.add(stone);
        }


        while(list.size() > 1){
            Collections.sort(list);

            int m1 = list.remove(list.size()-1);
            int m2 = list.remove(list.size()-1);

            if(m1 == m2){
               continue;
            }

            list.add(m1-m2);
        }

        return list.size() == 0 ? 0 : list.get(0);
    }
}



SOLUTION 2: 
TC : O(n*logn)
SC : (n)

class Solution {
    public int lastStoneWeight(int[] stones) {
        PriorityQueue<Integer> pq = new PriorityQueue<>(Collections.reverseOrder());

        for (int stone : stones) {
            pq.add(stone);
        }

        while (pq.size() > 1) {

            int m1 = pq.poll();
            int m2 = pq.poll();

            if (m1 == m2) {
                continue;
            }

            pq.add(m1 - m2);
        }

        return pq.size() == 0 ? 0 : pq.peek();
    }
}
