class KthLargest {

    PriorityQueue<Integer> minHeap;
    int kth;
    public KthLargest(int k, int[] nums) {
        kth = k;
        minHeap = new PriorityQueue<Integer>();

        for(int i=0; i<Math.min(nums.length, k); i++){
            minHeap.add(nums[i]);
        }

        for(int j=k; j<nums.length; j++){
            if(nums[j] > minHeap.peek()){
                minHeap.add(nums[j]);
                minHeap.remove();
            }
        }
        
    }
    
    public int add(int val) {

        if(minHeap.isEmpty()){
            minHeap.add(val);
            return minHeap.peek();
        }

        if(minHeap.size() < kth){
            minHeap.add(val);
            return minHeap.peek();
        }

        if(val > minHeap.peek()){
            minHeap.add(val);
            minHeap.remove();
        }

        return minHeap.peek();
        
    }
}


