SOLUTION 1:
TC : O(m.n + m^2 (log(n+m))
SC : O(n + m)

class KthLargest {
    List<Integer> list;
    int kth;

    public KthLargest(int k, int[] nums) {
        list = new ArrayList<>();
        kth = k;

        for(int num : nums){
            list.add(num);
        }

        
    }
    
    public int add(int val) {

        list.add(val);
        Collections.sort(list);
        
        return list.get(list.size()-kth);
        
    }
}


