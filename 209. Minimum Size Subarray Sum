SOLUTION 1:
TC : O(n^2)
SC : O(1)

class Solution {
    public int minSubArrayLen(int target, int[] nums) {
        int sum = 0;
        int size = Integer.MAX_VALUE;

        for(int i=0; i<nums.length; i++){
            sum = 0;
            for(int j =i; j<nums.length; j++){
                sum+=nums[j];

                if(sum >= target){
                    size = Math.min(size, j-i+1);
                    break;
                }
            }
        }

        return size == Integer.MAX_VALUE ? 0 : size;


    }
}


SOLUITON 2:
TC : O(n)
SC : O(1)

class Solution {
    public int minSubArrayLen(int target, int[] nums) {
        int sum = 0;
        int size = Integer.MAX_VALUE;

        int i =0;
        int j =0;

        while(j < nums.length){
            sum+=nums[j];

            while(sum >=target){
                size = Math.min(size, j-i+1);
                sum-=nums[i];
                i++;
            }

            j++;
        }

        return size == Integer.MAX_VALUE ? 0 : size;


    }
}

